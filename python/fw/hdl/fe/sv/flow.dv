# yaml-language-server: $schema=https://dv-flow.github.io/flow.dv.schema.json
package:
  name: fw.hdl.fe.sv
  desc: fw-hdl static front end (core-layer1.md §6.7)
  doc: |
    Elaborate a design written against the fw-hdl SV API and emit Verilog.
    The design's own sources are FileSets of filetype ``fwHdlSource``; any
    ``systemVerilogSource``/``verilogSource`` input is the RTL of the
    externs, used to check pin maps against module headers and passed on
    to the simulator.

  tasks:
  - name: Elaborate
    scope: export
    desc: Elaborate an fw-hdl design to Zuspec IR and an elaborated netlist
    doc: |
      Takes ``fwHdlSource`` (and extern RTL) directly, or from a ``Scan``
      upstream, which passes them on with its ``fwHdlScan`` FileSet. The
      sources are compiled again either way; the scan is checked against
      the elaborated ``protocols`` (FW-E-SCAN-STALE where they differ).
    consumes:
    - filetype: fwHdlSource
    - filetype: fwHdlScan
    - filetype: systemVerilogSource
    - filetype: verilogSource
    passthrough: none
    with:
      top:
        doc: The top component class, as SV type text (``pkg::chain#(bit[7:0])``)
        type: str
      spec:
        doc: The fw-hdl-spec checkout (default $FW_HDL_SPEC, else $IVPM_PACKAGES/fw-hdl-spec)
        type: str
        value: ""
      parameterize:
        doc: One module per class, with parameters, where the structure allows (§6.6)
        type: bool
        value: true
      require_param:
        doc: Make a class that must be emitted per specialization an error, not a note
        type: bool
        value: false
      domain_severity:
        doc: |
          Crossing severities by kind and relation, overriding the kinds' own:
          ``{fw_reset_kind: {unrelated: warning}}``. A relation is ``same``,
          ``related`` or ``unrelated``; a severity ``none``, ``info``,
          ``warning`` or ``error`` (``none`` silences).
        type: map
        value: {}
    shell: pytask
    run: fw.hdl.fe.sv.dfm.Elaborate

  - name: Scan
    scope: export
    desc: Find the protocols, bundles and converters of fw-hdl sources, with no top
    doc: |
      Writes ``scan.json`` (the netlist-form ``protocols`` table, the
      classes visited) and ``scan.zir`` (Zuspec IR: each protocol's API
      interface classes and the types they use), as a ``fwHdlScan``
      FileSet. The ``fwHdlSource`` and RTL inputs are passed on.
    consumes:
    - filetype: fwHdlSource
    - filetype: systemVerilogSource
    - filetype: verilogSource
    passthrough: none
    with:
      spec:
        doc: The fw-hdl-spec checkout (default $FW_HDL_SPEC, else $IVPM_PACKAGES/fw-hdl-spec)
        type: str
        value: ""
    shell: pytask
    run: fw.hdl.fe.sv.dfm.Scan

  - name: GenKit
    scope: export
    desc: Generate a protocol kit's derived classes (proxies, listeners, txns, ...) as one SV package
    doc: |
      Scans the kit's ``fwHdlSource`` and writes ``<core pkg>_gen_pkg.sv``
      (``fw.hdl.gen.gen_kit``), a ``systemVerilogSource`` FileSet that
      imports ``fw_hdl_pkg`` and the core package. The ``fwHdlSource`` and
      RTL inputs are passed on. The task re-runs when the generators
      change, as well as when its inputs do.
    consumes:
    - filetype: fwHdlSource
    - filetype: systemVerilogSource
    - filetype: verilogSource
    passthrough: none
    with:
      spec:
        doc: The fw-hdl-spec checkout (default $FW_HDL_SPEC, else $IVPM_PACKAGES/fw-hdl-spec)
        type: str
        value: ""
      pkg_name:
        doc: The generated package's name (default ``<core pkg>_gen_pkg``)
        type: str
        value: ""
    shell: pytask
    run: fw.hdl.fe.sv.dfm.GenKit
    uptodate: fw.hdl.fe.sv.dfm.GenKitUpToDate

  - name: EmitSV
    scope: export
    desc: Emit Verilog from fw-hdl Zuspec IR (structural flattening, then zuspec-be-sv)
    consumes:
    - filetype: zuspecIR
    - filetype: systemVerilogSource
    - filetype: verilogSource
    passthrough: none
    with:
      top_module:
        doc: The top module's name (default the top class's name)
        type: str
        value: ""
      width_params:
        doc: Lower packed type parameters to int width parameters (``parameter int T_W``) for tools without ``parameter type`` (yosys read -formal, Verilog-2005)
        type: bool
        value: false
    shell: pytask
    run: fw.hdl.fe.sv.dfm.EmitSV
